# Copy to .env (gitignored). Any Makefile target that needs it creates it for you.
# Every field on app.core.settings.Settings belongs here, or the next clone breaks.

PROJECT_NAME=befit101
ENVIRONMENT=development
LOG_LEVEL=INFO
# Route prefix for the v1 router. Rarely changed; uncomment to override.
#API_V1_STR=/api/v1

# --- Host port mappings (read by docker compose, not by Settings) ------------
API_PORT=8000
# 5433 on purpose: a natively installed postgres binds 127.0.0.1:5432 and a
# loopback-specific bind beats Docker's 0.0.0.0:5432, so localhost:5432 would
# silently reach the wrong server. Inside the compose network it is still 5432.
DB_PORT=5433
REDIS_PORT=6379

# --- Database ----------------------------------------------------------------
# `localhost` is for running the API on the host (`make run`, pytest). The
# compose file overrides this to the service name `postgres` for the container.
DB_HOST=localhost
DB_NAME=befit
DB_USER=befit
DB_PASSWORD=befit

# --- Redis -------------------------------------------------------------------
# Same host/container split as DB_HOST; compose overrides it to `redis`.
REDIS_HOST=localhost
# Catalog responses are master data, rewritten only by `make seed` (which drops
# the cache namespace afterwards). Set to 0 to serve every request from Postgres.
CATALOG_CACHE_TTL_SECONDS=3600

# --- Security ----------------------------------------------------------------
# At least 32 chars — RFC 7518 §3.2's floor for HMAC-SHA256, enforced by
# Settings. Generate with: openssl rand -hex 32
SECRET_KEY=replace-me-with-openssl-rand-hex-32-output
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Email (Resend) ----------------------------------------------------------
# Leave RESEND_API_KEY empty in development: outgoing mail is logged instead of
# sent, so no credentials and no network are needed. Set it in production —
# get_email_sender() logs an error if it is missing outside development.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
# Complete From value, display name included. The sending domain must be
# verified in Resend; onboarding@resend.dev only delivers to the account owner.
EMAIL_FROM=befit <onboarding@resend.dev>
# Where the emailed reset link points; the token is appended as ?token=...
PASSWORD_RESET_URL=http://localhost:8000/reset-password

# --- Google OAuth (authorization code flow) ----------------------------------
# From the Google Cloud console. Empty = /auth/google/login returns 503.
# GOOGLE_REDIRECT_URI must match the registered value exactly, scheme and path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# How long the browser has to finish consent before the state expires.
OAUTH_STATE_TTL_SECONDS=600

# --- MCP (Model Context Protocol) ---------------------------------------------
# Exposes the app as tools for Claude chat/cowork, mounted at /mcp.
MCP_ENABLED=true
# This API's own public origin — the OAuth issuer MCP clients see. Must match
# exactly (scheme, host, no trailing slash) or RFC 8414 discovery breaks.
MCP_ISSUER_URL=http://localhost:8000
